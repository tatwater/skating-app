{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".vercel/output/**"],
      // Turbo runs tasks in `strict` env mode, so anything not listed here is REMOVED from the
      // build's environment — and is absent from the cache hash, so changing it replays a stale
      // build instead of rebuilding. Framework inference doesn't save us: turbo detects this
      // package as `nitro`, not `vite`, so it infers no `VITE_` prefix. Hence the wildcard —
      // every `VITE_*` var is baked into the client bundle at build time, so every one of them
      // both belongs in the build environment and must participate in the hash.
      "env": ["SENTRY_ORG", "SENTRY_PROJECT", "SENTRY_AUTH_TOKEN", "VITE_*"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
