# Dependencies
node_modules/

# Turborepo
.turbo

# Build outputs
dist/
build/
.output/
.vercel/
.nitro/
coverage/

# Expo / React Native (generated by prebuild / EAS — CNG keeps these out of git)
.expo/
web-build/
/apps/*/ios/
/apps/*/android/
*.orig.*

# Convex — `convex/_generated/` is deliberately COMMITTED, per Convex's own guidance
# ("should be committed to the repo ... your code won't typecheck without it").
# Do NOT re-ignore it: cloud EAS builds upload via git, so ignoring it breaks the
# JS bundle with `Unable to resolve module @skating/convex/api`.

# Environment / secrets — never commit real values
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# OS / editor
.DS_Store
.idea/

# Claude
.claude

# Training data
training_data/
