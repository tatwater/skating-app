# Dependencies
node_modules/

# Turborepo
.turbo

# Build outputs
dist/
build/
.output/
.vercel/
.nitro/
coverage/

# Expo / React Native (generated by prebuild / EAS — CNG keeps these out of git)
.expo/
web-build/
/apps/*/ios/
/apps/*/android/
*.orig.*

# Environment / secrets — never commit real values
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# OS / editor
.DS_Store
.idea/

# Claude
.claude

# Training data
training_data/
app_ui_inspiration/

# Per-run scratch, at the ROOT this time.
#
# Every script package already ignores its own `.scratch/` (etl, imagery, lake-depth, basemap,
# admin-areas, bathymetry) — but a script invoked from the repo root writes here instead, and this
# was missing, so a one-off zonal-statistics fixture sat in `git status` as an untracked directory
# nobody could place. Same rule as the others: disposable, regenerable, never the source of truth.
.scratch/

# Python bytecode. A `.pyc` is a build artifact of one interpreter version — ours came out of the
# imagery container as `cpython-314` — so it is regenerable, version-locked, and churns on every run.
# Ten of them were committed by accident on 2026-08-25.
__pycache__/
*.py[cod]

# Design exports (large generated SVGs for Figma)
/exports/

# Teagan's questions/reminders for Claude
CLAUDE_NOTES.md
