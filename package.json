{
  "name": "skating",
  "version": "0.0.1",
  "private": true,
  "description": "Map-first peer ice-reporting app for Nordic (wild) ice skating",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "convex-dev": "pnpm --filter @skating/convex exec convex dev",
    "convex-deploy": "pnpm --filter @skating/convex exec convex deploy",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^10.0.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "turbo": "^2.10.4",
    "typescript": "^5.7.0"
  }
}
