# Copy to .env.local (gitignored) — non-secret orchestration config only.
#
# Secrets do NOT belong here. R2 credentials live in `fly secrets` and are injected into the Machine's
# environment; see README.md. The only reason this file exists is so `fan-out.sh` can be run without
# remembering four flags.

# The Fly app the Machines are spawned into.
FLY_APP=skating-imagery

# Where per-job Machines run. `sjc` (San Jose) is the closest live Fly region to AWS us-west-2, home
# of the public `sentinel-cogs` bucket. NOT `sea` — Seattle is deprecated and refuses new resources.
# Switch to `fra` if the granule source settles on Copernicus CDSE in Europe. This is compute
# placement and has nothing to do with where skaters are — artifacts serve from R2's edge either way.
FLY_REGION=sjc

# Pin the exact image a fan-out runs, printed by `fly deploy --build-only --push`.
# Leave unset to have fan-out.sh refuse and tell you how to build one.
# FLY_IMAGE=registry.fly.io/skating-imagery:deployment-01ABCDEF

# Concurrent Machines during a backfill. 25 is the §C2 figure: a season's ~750 granules in a few hours
# rather than five days, at identical total cost. It is a cap on Machines that are *alive*, which
# fan-out.sh polls for — not on spawn calls, which are detached and return in milliseconds.
MAX_PARALLEL=25

# ⚠ **Required for every real cut, and it is NOT the frame's season.** This names which `bake-masks`
# artifact a cut clips against (`masks/<MASK_SEASON>.fgb` in R2) — normally the newest bake, because
# today's corpus is the best shape of those lakes we have. The season a frame is *filed* under is
# derived from its own capture date inside cut-granule.sh, so a backfill of winter 2025-26 is cut
# against `winter-2026-27` masks and lands in `frames/winter-2025-26/`. Conflating them files a whole
# backfill under the wrong year.
#
# fan-out.sh refuses to spawn without it (except `--smoke`), because unset means every Machine boots,
# exits 1, and reports "spawned".
MASK_SEASON=winter-2026-27
