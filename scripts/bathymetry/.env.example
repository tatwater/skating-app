# Raw-archive mirror config (N6b). Copy to `.env.local`, which is gitignored.
# Holds NO secrets — the rclone credentials live in ~/.config/rclone/rclone.conf.

# The rclone remote name. Shared with the basemap upload (see scripts/basemap/RCLONE_SETUP.md).
RCLONE_REMOTE=r2

# A PRIVATE bucket, separate from `skating-basemap`. The basemap bucket has r2.dev public access
# enabled for browser range-reads; mirroring third-party state data there would republish it.
RAW_BUCKET=skating-raw
