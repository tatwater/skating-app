# NREL WIND Toolkit credentials (N6c A4b). Copy to `.env.local`, which is gitignored.
#
# Get a free key, instantly, at https://developer.nlr.gov/signup/ — it arrives by email.
#
# Named after the DATASET rather than the provider on purpose: the API's host moved from
# `developer.nrel.gov` to `developer.nlr.gov` between its docs being written and this being built,
# so `NREL_API_KEY` would already be stale. The WIND Toolkit is what stays put.
WIND_TOOLKIT_API_KEY=DEMO_KEY
# The API requires an active email on every request, not only at signup.
WIND_TOOLKIT_EMAIL=you@example.com
