# Depth-source archive mirror config (N6a). Copy to `.env.local`, which is gitignored.
# Holds NO secrets — the rclone credentials live in ~/.config/rclone/rclone.conf.

# The rclone remote name. Shared with the other archives and the basemap upload.
RCLONE_REMOTE=r2

# A PRIVATE bucket, separate from `skating-basemap` (which has r2.dev public access on for browser
# range-reads). Mirroring third-party source data into a public bucket would republish it as a side
# effect of backing it up — and LAGOS-US DEPTH's licence has not been read yet, so that would be
# republishing something under terms nobody has checked.
RAW_BUCKET=skating-raw-lake-depth
