# Config for scripts/basemap/upload-r2.sh — copy to .env.local and fill in.
# NON-SECRET only. rclone credentials (access key / secret) do NOT go here —
# they live in ~/.config/rclone/rclone.conf. .env.local is gitignored.

# rclone remote name — from `rclone config create <name> s3 ...` (we used "r2").
R2_REMOTE=r2

# The R2 bucket holding the .pmtiles basemaps.
R2_BUCKET=skating-basemap

# Public base URL for the bucket (no trailing slash). Enable public access on the
# bucket first (r2.dev subdomain to start, or a custom domain — see README).
#   e.g. https://pub-xxxxxxxxxxxx.r2.dev   or   https://tiles.example.com
R2_PUBLIC_BASE_URL=
