{
  "name": "@skating/etl",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Manual OSM \u2192 Convex water-body ETL (Phase 01). Not built or deployed.",
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "transform": "tsx src/cli.ts",
    "load": "tsx src/load.ts",
    "load-depths": "tsx src/loadDepths.ts",
    "access-transform": "tsx src/accessCli.ts",
    "load-access": "tsx src/loadAccess.ts",
    "load-sub-areas": "tsx src/loadSubAreas.ts",
    "prune-floor": "tsx src/pruneFloor.ts",
    "archive": "tsx src/fetchExtract.ts",
    "archive-nhd": "tsx src/fetchNhd.ts",
    "archive-3dhp": "tsx src/fetch3dhp.ts",
    "measure-3dhp": "tsx src/measure3dhp.ts",
    "audit-archives": "tsx src/auditArchives.ts",
    "merge": "tsx --max-old-space-size=12288 src/merge.ts",
    "classify-dry-run": "tsx src/classifyDryRun.ts",
    "reconcile": "tsx src/reconcileNhd.ts",
    "load-reconciliation": "tsx src/loadReconciliation.ts",
    "archive-gnis": "tsx src/gnisArchive.ts",
    "bake-off": "tsx --max-old-space-size=12288 src/bakeOff.ts",
    "resolve-merge-duplicates": "tsx src/resolveMergeDuplicates.ts",
    "referee-duplicates": "tsx --max-old-space-size=12288 src/refereeDuplicates.ts",
    "tidal-band": "tsx --max-old-space-size=8192 src/tidalBand.ts",
    "retire-absorbed": "tsx src/retireAbsorbed.ts",
    "landmarks": "tsx --max-old-space-size=8192 src/landmarkCli.ts",
    "load-landmarks": "tsx src/loadLandmarks.ts",
    "load-landmark-names": "tsx src/loadLandmarkNames.ts"
  },
  "dependencies": {
    "@skating/core": "workspace:*",
    "@turf/simplify": "^7.4.0",
    "@skating/run-log": "workspace:*"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
