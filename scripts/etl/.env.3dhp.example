# 3DHP waterbody-clip mirror config (N7). Copy to `.env.3dhp.local`, which is gitignored.
# Holds NO secrets — rclone credentials live in ~/.config/rclone/rclone.conf.

RCLONE_REMOTE=r2

# A PRIVATE bucket. Separate from `skating-raw-nhd` because these are two different catalogues on
# two different lifecycles: NHD is retired and terminal, 3DHP is refreshed annually.
RAW_BUCKET=skating-raw-3dhp
