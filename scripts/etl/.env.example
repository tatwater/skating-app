# OSM extract mirror config. Copy to `.env.local`, which is gitignored.
# Holds NO secrets — rclone credentials live in ~/.config/rclone/rclone.conf.

RCLONE_REMOTE=r2

# A PRIVATE bucket, separate from the bathymetry archive and from `skating-basemap` (which has
# r2.dev public access on for browser range-reads).
RAW_BUCKET=skating-raw-lake-osm
