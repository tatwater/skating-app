# GNIS Domestic Names mirror config (N7 / D105). Copy to `.env.gnis.local`, which is gitignored.
# Holds NO secrets — rclone credentials live in ~/.config/rclone/rclone.conf.

RCLONE_REMOTE=r2

# A PRIVATE bucket, separate from the hydrography archives because it is a different kind of thing:
# a gazetteer of names, on its own (unversioned, overwrite-in-place) upstream lifecycle.
RAW_BUCKET=skating-raw-gnis
