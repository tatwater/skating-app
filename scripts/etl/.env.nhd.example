# NHD geodatabase mirror config (N7). Copy to `.env.nhd.local`, which is gitignored.
# Holds NO secrets — rclone credentials live in ~/.config/rclone/rclone.conf.
#
# Kept separate from `.env.local` on purpose: that one belongs to the OSM extract mirror and sets
# its own RAW_BUCKET. One package, two archives, two config files.

RCLONE_REMOTE=r2

# A PRIVATE bucket, separate from `skating-raw-lake-osm` and from `skating-basemap` (which has
# r2.dev public access on for browser range-reads — mirroring source data there would republish it).
RAW_BUCKET=skating-raw-nhd
