# Scratch working dir for raw extracts + intermediate GeoJSON/NDJSON.
# The Geofabrik .pbf is large and rebuilt daily — never commit it (see README).
.scratch/

# Intermediate artifacts if run outside .scratch/
*.osm.pbf
*.osm.pbf.md5

# The permanent OSM snapshot archive. Unlike `.scratch/`, this is NOT disposable: it is what makes a
# corpus reproducible, and Geofabrik rebuilds `-latest` daily so a deleted extract is unrecoverable.
# Mirror it rather than removing it. See README §"Pinning the OSM snapshot".
.raw/

# Mirror config (holds no secrets, but stays local).
.env.local
