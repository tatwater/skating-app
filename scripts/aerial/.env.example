# Copy to .env.local (gitignored). `run-aerial.sh` and `spawn.sh` load it; a value here wins over the
# shell's. Never echo a value — `grep -o '^[A-Z_][A-Z0-9_]*=' .env.local` lists the names.
#
# No secret belongs here. The R2 credentials the Machines write with are the Fly app's staged
# secrets (`R2_ACCESS_KEY_ID`, `R2_SECRET_ACCESS_KEY`, `R2_ENDPOINT`, `R2_BUCKET`), read only on the
# Machines; the laptop reaches the bucket through its own rclone remote. Blank means the default.

# The aerial image pinned by digest, `registry.fly.io/skating-imagery@sha256:<64 hex>` (README,
# gated step 1). The tiles stage and spawn.sh refuse without it; never the winter cutter's FLY_IMAGE.
AERIAL_IMAGE=

# The bucket the summer aerial lives in: skating-imagery (G-6, B05 §2.2), under dev/naip/.
R2_BUCKET=

# The laptop's rclone remote that reaches R2_BUCKET (default r2): the tiles stage uploads the
# manifest and reads the done records through it, verify serves it on localhost, cleanup deletes.
R2_REMOTE=

# The bucket's public origin, which verify reads the published archive, index and manifest from.
R2_PUBLIC_BASE_URL=

# The published manifest a `--from-current` select diffs against (its public URL, or a local copy).
NAIP_MANIFEST_URL=

# Fly placement and sizes (spawn.sh). Defaults: skating-imagery; the work tiles in ams (beside
# Planetary Computer's blobs in Azure West Europe); the assembler in iad (beside the bucket — set ams
# if Cloudflare's dashboard says the bucket is in Western Europe); 25 live Machines on the app, the
# winter pump's included; shared-cpu-4x with 2048 MB a work tile, 4096 MB the assembler.
FLY_APP=
FLY_REGION=
FLY_ASSEMBLE_REGION=
MAX_PARALLEL=
FLY_VM_SIZE=
FLY_VM_MEMORY=
FLY_ASSEMBLE_VM_SIZE=
FLY_ASSEMBLE_MEMORY=
