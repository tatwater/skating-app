{
  "name": "@skating/seed-destinations",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Match a curated shortlist of regional skating destinations to corpus bodies and apply curatedBoost (A06c \u00a72.3a/\u00a74). Not built or deployed.",
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "seed": "tsx src/cli.ts",
    "seed-standing": "tsx src/standing.ts",
    "build-input": "tsx src/buildInputCli.ts",
    "build-bay-requests": "tsx src/bayRequestsCli.ts build",
    "seed-bay-requests": "tsx src/bayRequestsCli.ts seed"
  },
  "dependencies": {
    "@skating/core": "workspace:*",
    "@skating/run-log": "workspace:*"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.0",
    "vitest": "^3.2.7"
  }
}
