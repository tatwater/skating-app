# Expo/Metro need a flat node_modules layout; pnpm's default isolated (symlinked)
# store trips Metro's resolver. `hoisted` makes pnpm lay out node_modules like
# npm/yarn, which is standard practice for Expo + pnpm monorepos (D8/D39).
#
# Trade-off (see also the isolated-linker note): hoisting reintroduces "phantom
# dependencies" — a package can import something it never declared and still
# resolve. We keep declaring every direct dependency to stay honest.
node-linker=hoisted

# ---------------------------------------------------------------------------
# FontAwesome Pro
# ---------------------------------------------------------------------------
# The whole `@fortawesome` scope resolves from FontAwesome's own registry, which
# serves the Pro packages *and* mirrors the free ones. It is scope-wide because
# npm registry config has no finer grain than a scope — so once this line exists,
# every `@fortawesome/*` install needs a valid Pro token, including the free
# packages. ⚠ That means `pnpm install` cannot succeed for anyone without a seat.
@fortawesome:registry=https://npm.fontawesome.com/

# ⚠ **The token does not go in this file — this file is committed.** It goes in
# your `~/.npmrc`, which lives outside the repo and so cannot be committed by
# accident:
#
#     //npm.fontawesome.com/:_authToken=<token>
#
# ⚠ And it must not go here as a `${FONTAWESOME_NPM_AUTH_TOKEN}` reference
# either, however tempting that looks. When pnpm cannot expand an env var in an
# .npmrc it discards **the whole file**, not just the offending line — so an
# unset variable would silently take the scope mapping above down with it, the
# scope would quietly fall back to registry.npmjs.org, and the failure would
# surface as a confusing 404 on a Pro package rather than as a missing token.
# (`node-linker` above would go with it too, which breaks Metro.)
#
# CI and EAS have no `~/.npmrc`, so they append that same line at build time
# from a secret instead. See docs/fontawesome-pro.md.
