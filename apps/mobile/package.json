    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "check-types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "eas-build-pre-install": "if [ -n \"$FONTAWESOME_NPM_AUTH_TOKEN\" ]; then printf '//npm.fontawesome.com/:_authToken=%s\\n' \"$FONTAWESOME_NPM_AUTH_TOKEN\" >> ~/.npmrc; else echo 'WARNING: FONTAWESOME_NPM_AUTH_TOKEN is unset - the @fortawesome install will 401. Set it in this EAS environment.'; fi"
  },
