# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# EXPO_PUBLIC_* vars are inlined into the client bundle by Metro — safe only for
# PUBLISHABLE / public keys.

# Clerk publishable key (D26) — starts with pk_test_ / pk_live_
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_PLACEHOLDER

# Convex deployment URL (D2) — e.g. https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_URL=https://placeholder.convex.cloud

# Sentry DSN (D29) — client-side crash reporting
EXPO_PUBLIC_SENTRY_DSN=

# Sentry build-time config (source-map upload during EAS builds; NOT bundled).
# SENTRY_AUTH_TOKEN is a secret — set it in EAS secrets, not here, for real builds.
SENTRY_ORG=PLACEHOLDER_ORG
SENTRY_PROJECT=PLACEHOLDER_PROJECT
SENTRY_AUTH_TOKEN=
