# Copy to `.env` and fill in real values. `.env` is gitignored.
# VITE_* vars are exposed to the client bundle by Vite — safe only for PUBLIC keys.
# The Clerk keys below are read server-side by @clerk/tanstack-react-start (no VITE_ prefix).

# Clerk (D26). Publishable key is public; SECRET KEY must stay server-side only.
CLERK_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
CLERK_SECRET_KEY=sk_test_PLACEHOLDER

# Convex deployment URL (D2) — e.g. https://your-deployment.convex.cloud
VITE_CONVEX_URL=https://placeholder.convex.cloud

# Sentry DSN (D29) — client + server crash reporting. Use the DSN from a SEPARATE `skating-web`
# Sentry project (same org as mobile, distinct project — see README). Blank disables both.
# Not secret (it's shipped to the browser); one value drives the client and the SSR server.
VITE_SENTRY_DSN=

# Sentry build-time source-map upload (D29). Only needed where you build for production
# (i.e. set these on Vercel, not usually locally). Without SENTRY_AUTH_TOKEN the Vite plugin
# is skipped entirely, so builds still succeed — you just get unminified-only stack traces.
SENTRY_ORG=teagan-atwater
SENTRY_PROJECT=skating-web
SENTRY_AUTH_TOKEN=
